                p.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
                p.CalendarProperties.ShowTodayButton = false;
                p.ClientSideEvents.DateChanged = "function(s,e){normalizeMonthYear(s,e)}";
