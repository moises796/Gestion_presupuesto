        editButton.Image.Url = Url.Content("~/Content/img/edit2.png");
        editButton.Image.ToolTip = "Modificar";
        editButton.Image.Width = 30;
        editButton.Image.Height = 30;
        settings.CommandColumn.CustomButtons.Add(editButton);
        var inicioButton = new GridViewCommandColumnCustomButton() { ID = "btnInicio", Text = " " };
        inicioButton.Image.Url = Url.Content("~/Content/img/play.png");
        inicioButton.Image.ToolTip = "Iniciar proceso";
        inicioButton.Image.Width = 30;
        inicioButton.Image.Height = 30;
        settings.CommandColumn.CustomButtons.Add(inicioButton);
        var voboButton = new GridViewCommandColumnCustomButton() { ID = "btnVobo", Text = " " };
        voboButton.Image.Url = Url.Content("~/Content/img/vobo.png");
        voboButton.Image.ToolTip = "Detalle V°. b°.";
        voboButton.Image.Width = 30;
        voboButton.Image.Height = 30;
        settings.CommandColumn.CustomButtons.Add(voboButton);
        var finButton = new GridViewCommandColumnCustomButton() { ID = "btnFin", Text = " " };
        finButton.Image.Url = Url.Content("~/Content/img/see.png");
        finButton.Image.ToolTip = "Comprobante";
        finButton.Image.Width = 30;
        finButton.Image.Height = 30;
        settings.CommandColumn.CustomButtons.Add(finButton);
        settings.ClientSideEvents.CustomButtonClick = "function(s,e){ OnCustomButtonClick(s,e); }";
        var anularButton = new GridViewCommandColumnCustomButton() { ID = "btnAnular", Text = " " };
        anularButton.Image.Url = Url.Content("~/Content/img/delete.png");
        anularButton.Image.ToolTip = "Descartar";
        anularButton.Image.Width = 30;
        anularButton.Image.Height = 30;
        settings.CommandColumn.CustomButtons.Add(anularButton);
        settings.ClientSideEvents.CustomButtonClick = "function(s,e){ OnCustomButtonClick(s,e); }";

        settings.KeyFieldName = "id_movimiento_detalle_presupuesto";

        settings.SettingsPager.Visible = true;
        settings.Settings.ShowGroupPanel = false;
        settings.Settings.ShowFilterRow = false;

        settings.SettingsPager.Visible = true;
        settings.SettingsPager.PageSizeItemSettings.Visible = true;
        settings.SettingsPager.PageSizeItemSettings.Items = new string[] { "5", "10", "20", "50" };
        settings.SettingsPager.FirstPageButton.Visible = true;
        settings.SettingsPager.LastPageButton.Visible = true;
        settings.SettingsPager.PageSize = 5;
        settings.SettingsPager.PageSizeItemSettings.Position = PagerPageSizePosition.Left;
