        settings.SettingsPopup.EditForm.HorizontalAlign = PopupHorizontalAlign.WindowCenter;
        settings.Settings.ShowGroupPanel = false;
        settings.Settings.ShowFilterRow = false;
        settings.SettingsBehavior.AllowSelectByRowClick = true;

        settings.EditFormLayoutProperties.SettingsAdaptivity.AdaptivityMode = FormLayoutAdaptivityMode.SingleColumnWindowLimit;
        settings.EditFormLayoutProperties.SettingsAdaptivity.SwitchToSingleColumnAtWindowInnerWidth = 900;
        settings.SettingsPopup.EditForm.SettingsAdaptivity.Mode = PopupControlAdaptivityMode.OnWindowInnerWidth;
        settings.SettingsPopup.EditForm.PopupAnimationType = DevExpress.Web.AnimationType.Fade;
        settings.SettingsPopup.EditForm.Width = 1000;
        settings.CellEditorInitialize = (s, e) =>
        {
            MVCxGridView grids = s as MVCxGridView;
            if (e.Column.FieldName == "id_tipo_fuente_financiamiento")
            {
                ASPxComboBox combo = e.Editor as ASPxComboBox;

                var idFuente = grids.GetRowValuesByKeyValue(e.KeyValue, "id_fuente_financiamiento");

                if (idFuente != null && idFuente != DBNull.Value)
                {
                    combo.DataSource = clase.GetTipoFuenteFinanciamientoPorPadre(idFuente);
                    combo.DataBind();
                }
                else
                {
                    combo.DataSource = null;
                    combo.DataBind();
                }
            }
        };


        settings.Columns.Add(gridViewColumnSettings =>
        {
            gridViewColumnSettings.FieldName = "estatus_general";
            gridViewColumnSettings.Caption = "Nombre del proceso";
            gridViewColumnSettings.CellStyle.Wrap = DefaultBoolean.True;
            gridViewColumnSettings.AdaptivePriority = 1;
            gridViewColumnSettings.PropertiesEdit.EncodeHtml = false;
            gridViewColumnSettings.UnboundType = DevExpress.Data.UnboundColumnType.String;
            gridViewColumnSettings.Settings.AutoFilterCondition = AutoFilterCondition.Contains;
            gridViewColumnSettings.Settings.FilterMode = ColumnFilterMode.DisplayText;
        });

        settings.Columns.Add(gridViewColumnSettings =>
        {
            gridViewColumnSettings.FieldName = "nombre_proceso";
            gridViewColumnSettings.Caption = "Nombre del proceso";
            gridViewColumnSettings.AdaptivePriority = 1;
            gridViewColumnSettings.Visible = false;
            MVCxColumnTextBoxProperties editorProperties = gridViewColumnSettings.PropertiesEdit as MVCxColumnTextBoxProperties;
            editorProperties.ValidationSettings.RequiredField.IsRequired = true;
            editorProperties.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
            editorProperties.ValidationSettings.RequiredField.ErrorText = "Este campo es requerido.";
            gridViewColumnSettings.AdaptivePriority = 1;
        });

