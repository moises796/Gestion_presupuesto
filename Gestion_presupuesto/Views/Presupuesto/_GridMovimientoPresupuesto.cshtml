        settings.CommandColumn.ShowDeleteButton = false;
        settings.CommandColumn.ShowEditButton = false;

        settings.CommandColumn.CellStyle.CssClass = "cmdcol-vertical";
        settings.CommandColumn.Width = System.Web.UI.WebControls.Unit.Pixel(140);

