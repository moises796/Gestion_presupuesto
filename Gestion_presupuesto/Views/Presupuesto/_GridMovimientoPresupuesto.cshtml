        settings.Columns.Add(c =>
        {
            c.FieldName = "id_fuente_financiamiento";
            c.Caption = "Fuente de financiamiento";
            c.AdaptivePriority = 6;
            c.EditorProperties().ComboBox(p =>
            {
                p.TextField = "valor";
                p.ValueField = "id_fuente_financiamiento";
                p.ValueType = typeof(int);
                p.ClientSideEvents.Init = "function(s,e){obtenerfinanciamiento(s,e);}";
                p.ClientSideEvents.ValueChanged = "function(s,e){cambio_financiamiento(s,e);}";
                p.ValidationSettings.RequiredField.IsRequired = true;
                p.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
                p.ValidationSettings.RequiredField.ErrorText = "Este campo es requerido.";
                p.DataSource = clase.GetFuenteFinanciamiento();
            });
        });

        settings.Columns.Add(c =>
        {
            c.FieldName = "id_tipo_fuente_financiamiento";
            c.Caption = "Tipo fuente de financiamiento";
            c.AdaptivePriority = 7;
            c.EditorProperties().ComboBox(p =>
            {
                p.CallbackRouteValues = new { Controller = "Presupuesto", Action = "GetTipoFuenteFinanciamiento" };
                p.ValueField = "id_tipo_fuente_financiamiento";
                p.TextField = "valor";
                p.ValueType = typeof(int);
                p.ClientSideEvents.BeginCallback = "Tipofinanciamientomovimientopresupuesto_Begin";
                p.ClientSideEvents.EndCallback = "Tipofinanciamientomovimientopresupuesto_EndCallback";
                p.ValidationSettings.RequiredField.IsRequired = true;
                p.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
                p.ValidationSettings.RequiredField.ErrorText = "Este campo es requerido.";
                p.BindList(clase.GetAllFuenteFinanciamiento());
            });
