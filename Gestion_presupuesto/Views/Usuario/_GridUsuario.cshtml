@{
    Gestion_presupuesto.Controllers.UsuarioController clase = new Gestion_presupuesto.Controllers.UsuarioController();
    var grid = Html.DevExpress().GridView(settings => {
        settings.Name = "GridUsuario";
        settings.CallbackRouteValues = new { Controller = "Usuario", Action = "GridUsuario" };

        settings.SettingsEditing.AddNewRowRouteValues = new { Controller = "Usuario", Action = "GridUsuarioAddNew" };
        settings.SettingsEditing.UpdateRowRouteValues = new { Controller = "Usuario", Action = "GridUsuarioUpdate" };
        settings.SettingsEditing.DeleteRowRouteValues = new { Controller = "Usuario", Action = "GridUsuarioDelete" };
        settings.EnableRowsCache = false;
        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);

        settings.SettingsAdaptivity.AdaptivityMode = GridViewAdaptivityMode.HideDataCells;
        settings.SettingsSearchPanel.Visible = true;
        settings.SettingsAdaptivity.AllowOnlyOneAdaptiveDetailExpanded = true;
        settings.SettingsBehavior.AllowFocusedRow = true;
        settings.SettingsPopup.EditForm.Modal = true;
        settings.SettingsEditing.Mode = GridViewEditingMode.PopupEditForm;
        settings.SettingsPopup.EditForm.VerticalAlign = PopupVerticalAlign.Middle;
        settings.SettingsPopup.EditForm.HorizontalAlign = PopupHorizontalAlign.Center;
        settings.SettingsPopup.EditForm.ShowHeader = true;
        settings.SettingsText.PopupEditFormCaption = "Gestión usuarios";
        settings.SettingsBehavior.ConfirmDelete = true;
        settings.CommandColumn.ButtonRenderMode = GridCommandButtonRenderMode.Outline;

        settings.CommandColumn.Visible = true;
        settings.CommandColumn.ShowNewButtonInHeader = true;
        settings.CommandColumn.ShowDeleteButton = false;
        settings.CommandColumn.ShowEditButton = true;

        settings.KeyFieldName = "id_usuario";

        settings.SettingsPager.Visible = true;
        settings.Settings.ShowGroupPanel = false;
        settings.Settings.ShowFilterRow = false;
        settings.SettingsPager.Visible = true;
        settings.SettingsPager.PageSizeItemSettings.Visible = true;
        settings.SettingsPager.PageSizeItemSettings.Items = new string[] { "20", "50", "100", "250", "500" };
        settings.SettingsPager.FirstPageButton.Visible = true;
        settings.SettingsPager.LastPageButton.Visible = true;
        settings.SettingsPager.PageSize = 20;
        settings.SettingsPager.PageSizeItemSettings.Position = PagerPageSizePosition.Left;
        settings.SettingsPopup.EditForm.VerticalAlign = PopupVerticalAlign.WindowCenter;
        settings.SettingsPopup.EditForm.HorizontalAlign = PopupHorizontalAlign.WindowCenter;
        settings.Settings.ShowGroupPanel = false;
        settings.Settings.ShowFilterRow = false;
        settings.SettingsBehavior.AllowSelectByRowClick = true;



        settings.EditFormLayoutProperties.SettingsAdaptivity.AdaptivityMode = FormLayoutAdaptivityMode.SingleColumnWindowLimit;
        settings.EditFormLayoutProperties.SettingsAdaptivity.SwitchToSingleColumnAtWindowInnerWidth = 900;
        settings.SettingsPopup.EditForm.SettingsAdaptivity.Mode = PopupControlAdaptivityMode.OnWindowInnerWidth;
        settings.SettingsPopup.EditForm.PopupAnimationType = DevExpress.Web.AnimationType.Fade;
        settings.SettingsPopup.EditForm.Width = 1000;

        settings.Columns.Add(c =>
        {
            c.FieldName = "id_empleado";
            c.Caption = "Nombre del empleado";
            c.AdaptivePriority = 1;
            c.EditorProperties().ComboBox(p =>
            {
                p.TextField = "empleado";
                p.ValueField = "id_empleado";
                p.ValueType = typeof(int);
                p.ValidationSettings.RequiredField.IsRequired = true;
                p.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
                p.ValidationSettings.RequiredField.ErrorText = "Este campo es requerido.";
                p.DataSource = clase.GetEmpleados();
            });
        });

        settings.Columns.Add(c =>
        {
            c.FieldName = "id_rol_usuario";
            c.Caption = "Rol del usuario";
            c.AdaptivePriority = 1;
            c.EditorProperties().ComboBox(p =>
            {
                p.TextField = "valor";
                p.ValueField = "id_rol_usuario";
                p.ValueType = typeof(int);
                p.ValidationSettings.RequiredField.IsRequired = true;
                p.ValidationSettings.ErrorDisplayMode = ErrorDisplayMode.None;
                p.ValidationSettings.RequiredField.ErrorText = "Este campo es requerido.";
                p.DataSource = clase.GetRolUsuario();
            });
        });


        settings.Columns.Add(column =>
        {
            column.FieldName = "estado";
            column.Caption = "Estado";
            column.ColumnType = MVCxGridViewColumnType.CheckBox;
            ((CheckBoxProperties)column.PropertiesEdit).ToggleSwitchDisplayMode = ToggleSwitchDisplayMode.Always;
            column.AdaptivePriority = 3;
        });


        settings.EditFormLayoutProperties.Items.AddGroupItem(tabbedGroupSettings =>
        {
            tabbedGroupSettings.GroupBoxDecoration = GroupBoxDecoration.None;
            tabbedGroupSettings.ColumnCount = 2;
            tabbedGroupSettings.Items.Add(item =>
            {
                item.Name = "id_empleado";
                item.ColumnName = "id_empleado";
                item.ColumnSpan = 2;
                item.CaptionSettings.Location = LayoutItemCaptionLocation.Top;
            }); 
            tabbedGroupSettings.Items.Add(item =>
            {
                item.Name = "id_rol_usuario";
                item.ColumnName = "id_rol_usuario";
                item.ColumnSpan = 2;
                item.CaptionSettings.Location = LayoutItemCaptionLocation.Top;
            });

            tabbedGroupSettings.Items.Add(item =>
            {
                item.Name = "estado";
                item.ColumnName = "estado";
                item.ColumnSpan = 2;
                item.CaptionSettings.Location = LayoutItemCaptionLocation.Top;
            });
        });
        settings.EditFormLayoutProperties.Items.AddCommandItem(commandItem =>
        {
            commandItem.Width = 100;
            commandItem.VerticalAlign = FormLayoutVerticalAlign.Bottom;
            commandItem.HorizontalAlign = FormLayoutHorizontalAlign.Center;

        });
        settings.SettingsCommandButton.CancelButton.RenderMode = GridCommandButtonRenderMode.Danger;
        settings.SettingsCommandButton.UpdateButton.RenderMode = GridCommandButtonRenderMode.Button;
        settings.SettingsText.CommandCancel = "Cancelar";
        settings.SettingsText.CommandUpdate = "Modificar";
        settings.EditFormLayoutCreated = (sender, e) =>
        {
            MVCxGridView gridView = sender as MVCxGridView;
            if (gridView.IsNewRowEditing)
            {
                gridView.SettingsText.CommandUpdate = "Guardar";
                return;
            }
        };
    });
    if (ViewData["EditError"] != null){
        grid.SetEditErrorText((string)ViewData["EditError"]);
    }
}
@grid.Bind(Model).GetHtml()